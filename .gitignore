# --- Laboratori -----------------------------------------------------------------
# Snapshot pubblici CollecTor scaricati su richiesta
labs/*/data/collector/
labs/*/dati/collector/
labs/*/datos/collector/
labs/*/данные/collector/
labs/*/数据/collector/
# Sorgenti di terze parti scaricati per i laboratori (es. Arti)
labs/*/vendor/
# Le reti Chutney generano certificati, chiavi e identità private dei nodi:
# non vanno MAI in git.
# Regola generale per la cartella del laboratorio di ogni edizione, qualunque nome abbia:
labs/*/*/net/
labs/*/*/net-*/
labs/*/lab/net/
labs/*/laboratorio/net/
labs/*/лаборатория/net/
labs/*/实验室/net/
labs/*/lab/net-*/
labs/*/laboratorio/net-*/
labs/*/лаборатория/net-*/
labs/*/实验室/net-*/
labs/*/lab/esito-bridge
labs/*/laboratorio/esito-bridge
labs/*/лаборатория/esito-bridge
labs/*/实验室/esito-bridge
labs/*/lab/esito-bridge/
labs/*/laboratorio/esito-bridge/
labs/*/лаборатория/esito-bridge/
labs/*/实验室/esito-bridge/
labs/*/lab/verifica-bridge.stato
labs/*/laboratorio/verifica-bridge.stato
labs/*/лаборатория/verifica-bridge.stato
labs/*/实验室/verifica-bridge.stato
labs/*/lab/verifica-bridge.stato.tmp
labs/*/laboratorio/verifica-bridge.stato.tmp
labs/*/лаборатория/verifica-bridge.stato.tmp
labs/*/实验室/verifica-bridge.stato.tmp
# Catture di traffico del Laboratorio 10: da rivedere prima di qualunque pubblicazione
labs/*/lab/catture/
labs/*/laboratorio/catture/
labs/*/лаборатория/catture/
labs/*/实验室/catture/
*.pcap
*.pcapng

