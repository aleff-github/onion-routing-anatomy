# Book network with an obfs4 bridge (Chapter 16): unlike the regular book topology,
# this omits the onion service and adds a bridge authority, an obfs4 bridge, and its client.
Authority = Node(tag="a", authority=1, relay=1)
Middle    = Node(tag="r", relay=1)
Exit      = Node(tag="e", relay=1, exit=1)
Client    = Node(tag="c", client=1, launch_phase=2)
BridgeAuthority = Node(tag="ba", authority=1, bridgeauthority=1, relay=1)
Bridge = Node(tag="br", bridge=1, pt_bridge=1, relay=1, pt_transport="obfs4", sandbox=0)
BridgeClient = Node(tag="bc", client=1, bridgeclient=1, pt_transport="obfs4",
                    launch_phase=2, sandbox=0)

NODES = (Authority.getN(3) + BridgeAuthority.getN(1) + Middle.getN(3) + Exit.getN(2)
         + Bridge.getN(1) + Client.getN(1) + BridgeClient.getN(1))

ConfigureNodes(NODES)
